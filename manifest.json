{
  "manifest_version": 3,
  "name": "Font Glass — Local Font Styler",
  "version": "1.3.0",
  "description": "Web theo cách bạn muốn. Chọn font máy hoặc file, tách font Hàn/Trung/Nhật, Variable Font & Faux Bold, Ligatures code và kiểm tra Tiếng Việt.",
  "minimum_chrome_version": "103",
  "permissions": [
    "storage",
    "fontSettings",
    "activeTab",
    "scripting",
    "unlimitedStorage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Font Glass"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "fonts.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
